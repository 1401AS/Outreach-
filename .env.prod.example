# For docker-compose.prod.yml on a VPS. Copy to .env.prod and fill in.

# Your domain (its DNS A record must point at the server's IP)
DOMAIN="outreach.example.com"

# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD="change-me"
JWT_SECRET="change-me"
ENCRYPTION_KEY="change-me-64-hex-chars"

# Postal address shown in every email footer (CAN-SPAM)
COMPANY_ADDRESS="Your Company, 123 Street, City, Country"
