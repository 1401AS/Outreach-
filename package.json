{
  "name": "outreach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "start:web": "prisma db push --skip-generate && next start",
    "worker:prod": "tsx src/worker/index.ts",
    "start:all": "prisma db push --skip-generate && (tsx src/worker/index.ts & next start -p ${PORT:-3000} & wait -n)"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "imapflow": "^1.0.164",
    "ioredis": "^5.4.1",
    "jose": "^5.9.3",
    "mailparser": "^3.7.1",
    "next": "14.2.35",
    "nodemailer": "^6.9.15",
    "papaparse": "^5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/imapflow": "^1.0.19",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^6.4.16",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}
